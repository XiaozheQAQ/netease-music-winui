<Window
    x:Class="winuitest.Views.TrayMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:winuitest.Controls"
    Title="Luma Music">
    <Grid x:Name="Surface" RequestedTheme="Default" Background="Transparent">
        <Grid.Resources>
            <Style x:Key="MenuButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="12,9" />
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="CornerRadius" Value="7" />
            </Style>
            <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Padding" Value="0" />
            </Style>
        </Grid.Resources>
        <Border Background="{ThemeResource LumaInspectorBrush}" BorderBrush="{ThemeResource LumaBorderBrush}"
                BorderThickness="1" CornerRadius="12" Padding="7">
            <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                <StackPanel>
                    <Grid Margin="12,10,12,8" ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <controls:LumaBrandMark Width="32" Height="32" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock x:Name="TrackTitle" Text="Luma Music" FontSize="14" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" Foreground="{ThemeResource LumaTextPrimaryBrush}" />
                            <TextBlock x:Name="TrackArtist" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource LumaTextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="22" Margin="0,0,0,6">
                        <Button x:Name="PreviousButton" Style="{StaticResource TransportButton}" Tag="Previous" Click="Command_Click"
                                ToolTipService.ToolTip="上一首" AutomationProperties.Name="上一首">
                            <controls:FilledIcon Kind="Previous" FontSize="19" />
                        </Button>
                        <Button x:Name="PlayPauseButton" Style="{StaticResource AccentButtonStyle}" Width="42" Height="42"
                                CornerRadius="21" Padding="0" Tag="PlayPause" Click="Command_Click"
                                ToolTipService.ToolTip="播放 / 暂停" AutomationProperties.Name="播放或暂停">
                            <controls:FilledIcon x:Name="PlayPauseIcon" Kind="Play" FontSize="20" />
                        </Button>
                        <Button x:Name="NextButton" Style="{StaticResource TransportButton}" Tag="Next" Click="Command_Click"
                                ToolTipService.ToolTip="下一首" AutomationProperties.Name="下一首">
                            <controls:FilledIcon Kind="Next" FontSize="19" />
                        </Button>
                    </StackPanel>
                    <Border Height="1" Margin="8,6" Background="{ThemeResource LumaBorderBrush}" />
                    <Button x:Name="LyricsButton" Style="{StaticResource MenuButton}" Tag="NowPlaying" Click="Command_Click">
                        <StackPanel Orientation="Horizontal" Spacing="12"><controls:FilledIcon Kind="Lyrics" FontSize="17" /><TextBlock Text="正在播放" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuButton}" Tag="Playlists" Click="Command_Click">
                        <StackPanel Orientation="Horizontal" Spacing="12"><controls:FilledIcon Kind="Playlist" FontSize="17" /><TextBlock Text="我的歌单" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuButton}" Tag="Favorites" Click="Command_Click">
                        <StackPanel Orientation="Horizontal" Spacing="12"><controls:FilledIcon Kind="Heart" FontSize="17" /><TextBlock Text="喜欢的歌曲" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuButton}" Tag="Settings" Click="Command_Click">
                        <StackPanel Orientation="Horizontal" Spacing="12"><controls:FilledIcon Kind="Settings" FontSize="17" /><TextBlock Text="设置" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Border Height="1" Margin="8,6" Background="{ThemeResource LumaBorderBrush}" />
                    <StackPanel Margin="12,6,12,8" Spacing="7">
                        <TextBlock Text="输出设备" FontSize="12" Foreground="{ThemeResource LumaTextSecondaryBrush}" />
                        <ComboBox x:Name="AudioOutputs" HorizontalAlignment="Stretch" MinWidth="0"
                                  DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="AudioOutputs_SelectionChanged"
                                  AutomationProperties.Name="音频输出设备" />
                        <TextBlock x:Name="StatusText" Visibility="Collapsed" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{ThemeResource LumaTextSecondaryBrush}" />
                    </StackPanel>
                    <Border Height="1" Margin="8,6" Background="{ThemeResource LumaBorderBrush}" />
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button Style="{StaticResource MenuButton}" Tag="ShowWindow" Click="Command_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12"><controls:FilledIcon Kind="Home" FontSize="17" /><TextBlock Text="打开 Luma Music" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource TransportButton}" Tag="Exit" Click="Command_Click"
                                ToolTipService.ToolTip="退出 Luma Music" AutomationProperties.Name="退出 Luma Music">
                            <controls:FilledIcon Kind="Close" FontSize="17" />
                        </Button>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
