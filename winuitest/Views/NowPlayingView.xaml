<UserControl
    x:Class="winuitest.Views.NowPlayingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:winuitest.Controls"
    RequestedTheme="Dark" Background="Transparent" IsTabStop="True"
    Loaded="View_Loaded" Unloaded="View_Unloaded" SizeChanged="View_SizeChanged">
    <UserControl.Resources>
        <!-- Retain WinUI's native focus, pointer, press and disabled states. -->
        <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#18FFFFFF" />
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#28FFFFFF" />
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonForeground" Color="#F5FFFFFF" />
        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#CFFFFFFF" />
        <SolidColorBrush x:Key="SliderTrackValueFill" Color="#DCFFFFFF" />
        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="White" />
        <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="White" />
        <SolidColorBrush x:Key="SliderThumbBackground" Color="White" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="White" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="White" />
        <SolidColorBrush x:Key="SliderTrackFill" Color="#38FFFFFF" />
        <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#48FFFFFF" />
        <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#58FFFFFF" />
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="CornerRadius" Value="24" /><Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" /><Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="36" /><Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="4" /><Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="LyricButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="CornerRadius" Value="16" /><Setter Property="Padding" Value="18,14" />
            <Setter Property="BorderThickness" Value="0" /><Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>
    <Grid x:Name="LayoutRoot" Background="#3B383E" SizeChanged="LayoutRoot_SizeChanged">
        <!-- Clip the entire sheet before its parent applies the slide translation.
             The initial empty clip prevents the oversized ambient image from
             escaping during the first layout; code updates it to local bounds. -->
        <Grid.Clip><RectangleGeometry x:Name="SheetBoundsClip" Rect="0,0,0,0" /></Grid.Clip>
        <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Grid.RowSpan="3" IsHitTestVisible="False">
            <!-- A twelve-pixel decode gives a soft, album-derived wash without a web renderer. -->
            <Image x:Name="AmbientArtwork" Stretch="UniformToFill" Opacity="0.64" RenderTransformOrigin="0.5,0.5">
                <!-- Keep all four edges covered at every aspect ratio. Rotation
                     leaves uncovered wedges on wide windows, even with a clip. -->
                <Image.RenderTransform><ScaleTransform ScaleX="1.08" ScaleY="1.08" /></Image.RenderTransform>
            </Image>
            <Rectangle Fill="#4C000000" />
            <Rectangle>
                <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#3224242B" Offset="0" /><GradientStop Color="#243D3B47" Offset="0.5" /><GradientStop Color="#461E1D24" Offset="1" />
                </LinearGradientBrush></Rectangle.Fill>
            </Rectangle>
        </Grid>
        <Grid x:Name="HeaderControls" Margin="12,0,146,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button Style="{StaticResource CaptionButton}" Click="Close_Click" ToolTipService.ToolTip="收起" AutomationProperties.Name="收起正在播放">
                <controls:FilledIcon Kind="ChevronDown" FontSize="16" />
            </Button>
            <Border x:Name="HeaderDragArea" Grid.Column="1" Background="Transparent" />
            <Button x:Name="FullScreenButton" Grid.Column="2" Style="{StaticResource CaptionButton}" Click="FullScreen_Click" ToolTipService.ToolTip="全屏" AutomationProperties.Name="全屏播放界面">
                <controls:FilledIcon x:Name="FullScreenIcon" Kind="FullScreen" FontSize="16" />
            </Button>
        </Grid>
        <Grid x:Name="ContentGrid" Grid.Row="1" Margin="72,12,64,36" ColumnSpacing="76" SizeChanged="ContentGrid_SizeChanged">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="0.92*" /><ColumnDefinition Width="1.18*" /></Grid.ColumnDefinitions>
            <ScrollViewer x:Name="AlbumScroller" Grid.Column="0" Grid.RowSpan="2" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" VerticalAlignment="Center">
                <Grid x:Name="AlbumColumn" MaxWidth="520" HorizontalAlignment="Center" Margin="8,12,8,16">
                    <Grid.RowDefinitions><RowDefinition x:Name="ArtworkRow" Height="Auto" /><RowDefinition x:Name="PlaybackRow" Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="ArtworkColumn" Width="*" /><ColumnDefinition x:Name="PlaybackColumn" Width="0" /></Grid.ColumnDefinitions>
                    <Border x:Name="ArtworkFrame" Height="420" CornerRadius="14" Background="#24FFFFFF" HorizontalAlignment="Center" Translation="0,0,32">
                        <Border.Shadow><ThemeShadow /></Border.Shadow>
                        <Grid><controls:FilledIcon Kind="Music" FontSize="88" Foreground="#55FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="Artwork" Stretch="Fill" Width="{Binding ActualWidth, ElementName=ArtworkFrame}" Height="{Binding ActualHeight, ElementName=ArtworkFrame}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ImageFailed="Artwork_ImageFailed" />
                        </Grid>
                    </Border>
                    <StackPanel x:Name="PlaybackDetails" Grid.Row="1">
                    <Grid x:Name="TrackInfoGrid" Margin="0,30,0,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock x:Name="TrackTitle" Text="未播放" FontSize="25" FontFamily="ms-appx:///Assets/Fonts/ResourceHanRoundedCN-Bold.ttf#Resource Han Rounded CN" FontWeight="Bold" Foreground="#F5FFFFFF" TextTrimming="CharacterEllipsis" />
                            <controls:HandButton x:Name="TrackArtistButton" Click="Artist_Click" HorizontalAlignment="Left" HorizontalContentAlignment="Left" Padding="0,2" MinHeight="0" MinWidth="0" Background="Transparent" Foreground="#BFFFFFFF" BorderThickness="0" AutomationProperties.Name="查看歌手作品">
                                <controls:HandButton.Resources>
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#DEFFFFFF" />
                                </controls:HandButton.Resources>
                                <TextBlock x:Name="TrackArtist" FontSize="21" FontFamily="ms-appx:///Assets/Fonts/ResourceHanRoundedCN-Bold.ttf#Resource Han Rounded CN" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                            </controls:HandButton>
                        </StackPanel>
                        <Button x:Name="FavoriteButton" Grid.Column="1" Style="{StaticResource QuietButton}" Click="Favorite_Click" VerticalAlignment="Center" AutomationProperties.Name="收藏当前歌曲">
                            <Button.Resources><SolidColorBrush x:Key="ButtonBackground" Color="#14FFFFFF" /></Button.Resources>
                            <controls:HeartIcon x:Name="FavoriteIcon" FontSize="21" Foreground="{Binding Foreground, ElementName=FavoriteButton}" />
                        </Button>
                        <Button x:Name="OptionsButton" Style="{StaticResource QuietButton}" Grid.Column="2" AutomationProperties.Name="播放选项" ToolTipService.ToolTip="播放选项">
                            <Button.Resources><SolidColorBrush x:Key="ButtonBackground" Color="#14FFFFFF" /></Button.Resources>
                            <controls:FilledIcon Kind="More" FontSize="20" />
                            <Button.Flyout>
                                <Flyout Placement="Top">
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="FlyoutPresenter" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
                                            <Setter Property="Padding" Value="14,10" />
                                            <Setter Property="CornerRadius" Value="12" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <StackPanel MinWidth="232" MaxWidth="288" Spacing="6">
                                        <Grid ColumnSpacing="18" MinHeight="34">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="翻译" FontSize="14" VerticalAlignment="Center" />
                                                <ToggleSwitch x:Name="TranslationSwitch" Grid.Column="1" MinWidth="0" MinHeight="32" OnContent="" OffContent="" IsOn="True" Toggled="SubtitleSwitch_Toggled" AutomationProperties.Name="显示翻译" />
                                            </Grid>
                                            <Grid Grid.Column="1" ColumnSpacing="6">
                                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="罗马化" FontSize="14" VerticalAlignment="Center" />
                                                <ToggleSwitch x:Name="RomanizationSwitch" Grid.Column="1" MinWidth="0" MinHeight="32" OnContent="" OffContent="" IsOn="True" Toggled="SubtitleSwitch_Toggled" AutomationProperties.Name="显示罗马化" />
                                            </Grid>
                                        </Grid>
                                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                        <Grid ColumnSpacing="4" MinHeight="34">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="歌词校准" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Button x:Name="EarlierLyricsButton" Grid.Column="1" Content="−" Width="30" Height="30" Padding="0" CornerRadius="8" Click="EarlierLyrics_Click" ToolTipService.ToolTip="提前 0.5 秒" AutomationProperties.Name="歌词提前半秒" />
                                            <TextBlock x:Name="CorrectionValue" Grid.Column="2" Text="0.0 s" MinWidth="45" FontSize="13" TextAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.HelpText="仅调整当前歌曲的歌词时间" />
                                            <Button x:Name="LaterLyricsButton" Grid.Column="3" Content="+" Width="30" Height="30" Padding="0" CornerRadius="8" Click="LaterLyrics_Click" ToolTipService.ToolTip="延后 0.5 秒" AutomationProperties.Name="歌词延后半秒" />
                                            <Button x:Name="ResetLyricsButton" Grid.Column="4" Width="30" Height="30" Padding="0" CornerRadius="8" Click="ResetLyrics_Click" ToolTipService.ToolTip="重置校准" AutomationProperties.Name="重置当前歌曲的歌词校准">
                                                <controls:FilledIcon Kind="Refresh" FontSize="14" />
                                            </Button>
                                        </Grid>
                                        <Grid ColumnSpacing="8" MinHeight="32">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="音量" FontSize="14" VerticalAlignment="Center" />
                                            <Slider x:Name="VolumeBar" Grid.Column="1" Minimum="0" Maximum="100" Value="75" StepFrequency="1" SmallChange="1" LargeChange="5" VerticalAlignment="Center" ValueChanged="VolumeBar_ValueChanged" AutomationProperties.Name="音量百分比" />
                                            <TextBlock x:Name="VolumeValue" Grid.Column="2" Text="75%" MinWidth="37" TextAlignment="Right" FontSize="13" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                        <Button x:Name="CopyTrackLinkButton" Click="CopyTrackLink_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinHeight="32" CornerRadius="7" Padding="6,4" Background="Transparent" BorderThickness="0" AutomationProperties.Name="复制播放地址">
                                            <StackPanel Orientation="Horizontal" Spacing="9"><controls:FilledIcon Kind="Copy" FontSize="15" VerticalAlignment="Center" /><TextBlock Text="复制播放地址" FontSize="14" VerticalAlignment="Center" /></StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                    <Slider x:Name="SeekBar" Minimum="0" Maximum="1" CornerRadius="3" Margin="0,16,0,0" ValueChanged="SeekBar_ValueChanged" IsEnabled="False" AutomationProperties.Name="沉浸播放进度">
                        <Slider.Resources>
                            <x:Double x:Key="SliderTrackThemeHeight">6</x:Double>
                            <x:Double x:Key="SliderHorizontalHeight">28</x:Double>
                            <x:Double x:Key="SliderHorizontalThumbWidth">10</x:Double>
                            <x:Double x:Key="SliderHorizontalThumbHeight">10</x:Double>
                            <x:Double x:Key="SliderInnerThumbWidth">8</x:Double>
                            <x:Double x:Key="SliderInnerThumbHeight">8</x:Double>
                            <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="Transparent" />
                        </Slider.Resources>
                    </Slider>
                    <Grid Margin="0,-3,0,0">
                        <TextBlock x:Name="ElapsedText" Text="0:00" FontSize="12" Foreground="#85FFFFFF" />
                        <TextBlock x:Name="DurationText" Text="−0:00" FontSize="12" Foreground="#85FFFFFF" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid x:Name="TransportControls" Margin="-4,20,-4,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button x:Name="ShuffleButton" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" VerticalAlignment="Center" Click="Queue_Click" ToolTipService.ToolTip="播放列表" AutomationProperties.Name="播放列表"><controls:FilledIcon x:Name="ShuffleIcon" Kind="Queue" FontSize="20" /></Button>
                        <Button x:Name="PreviousButton" Grid.Column="1" Style="{StaticResource QuietButton}" Width="52" Height="52" VerticalAlignment="Center" Click="Previous_Click" AutomationProperties.Name="上一首"><controls:FilledIcon x:Name="PreviousIcon" Kind="Rewind" FontSize="34" /></Button>
                        <Button x:Name="PlayButton" Grid.Column="2" Style="{StaticResource QuietButton}" Width="72" Height="72" CornerRadius="36" Click="PlayPause_Click" AutomationProperties.Name="播放或暂停">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2CFFFFFF" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#3CFFFFFF" />
                            </Button.Resources>
                            <controls:FilledIcon x:Name="PlayIcon" Kind="Play" FontSize="36" />
                        </Button>
                        <Button x:Name="NextButton" Grid.Column="3" Style="{StaticResource QuietButton}" Width="52" Height="52" VerticalAlignment="Center" Click="Next_Click" AutomationProperties.Name="下一首"><controls:FilledIcon x:Name="NextIcon" Kind="FastForward" FontSize="34" /></Button>
                        <Button x:Name="RepeatButton" Grid.Column="4" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Repeat_Click" ToolTipService.ToolTip="循环播放" AutomationProperties.Name="循环播放"><controls:FilledIcon x:Name="RepeatIcon" Kind="Repeat" FontSize="20" /></Button>
                    </Grid>
                    <Border x:Name="SourceCaption" Visibility="Collapsed" Background="#662039" CornerRadius="8" Padding="8,4" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <TextBlock Text="试听" Foreground="#FFADB9" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <Grid x:Name="LyricsPane" Grid.Column="1" Grid.RowSpan="2">
                <ScrollViewer x:Name="LyricsScroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled" VerticalScrollMode="Enabled" SizeChanged="LyricsScroller_SizeChanged">
                    <StackPanel x:Name="LyricsStack" Spacing="24" Margin="0,24,6,600" />
                </ScrollViewer>
                <StackPanel x:Name="EmptyLyricsPanel" VerticalAlignment="Center" Spacing="18" Margin="18,0,24,0">
                    <TextBlock x:Name="EmptyLyricsText" Text="暂无歌词" FontSize="32" FontFamily="ms-appx:///Assets/Fonts/ResourceHanRoundedCN-Bold.ttf#Resource Han Rounded CN" FontWeight="Bold" Foreground="#B3FFFFFF" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Grid>
        <InfoBar x:Name="MessageBar" Grid.Row="2" IsOpen="False" IsClosable="True" Severity="Warning" Margin="40,0,40,22" />
    </Grid>
</UserControl>
