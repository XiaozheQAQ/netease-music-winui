<UserControl
    x:Class="winuitest.Views.StartupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:winuitest.Controls"
    Background="{ThemeResource LumaStartupBackgroundBrush}"
    IsTabStop="False"
    AutomationProperties.Name="Luma Music 正在启动"
    Loaded="View_Loaded" Unloaded="View_Unloaded">
    <Grid Background="{ThemeResource LumaStartupBackgroundBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0" Margin="24">
            <Grid Width="168" Height="168" HorizontalAlignment="Center">
                <!-- The shared vector mark paints on the first frame without
                     an image decoder, icon font, or surrounding halo. -->
                <Grid x:Name="LogoMotion" Width="104" Height="104" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <controls:LumaBrandMark />
                </Grid>
            </Grid>
            <TextBlock Text="Luma Music" FontFamily="Segoe UI Variable Display" FontSize="24" FontWeight="SemiBold"
                       CharacterSpacing="-20" Foreground="{ThemeResource LumaTextPrimaryBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,28" />
            <ProgressBar x:Name="LoadingProgress" Width="116" Height="3" MinHeight="3" Value="0" Maximum="100"
                         IsIndeterminate="False" Foreground="#E51B23"
                         HorizontalAlignment="Center" IsTabStop="False" AutomationProperties.Name="启动进度" />
        </StackPanel>
    </Grid>
</UserControl>
