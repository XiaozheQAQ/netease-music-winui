<UserControl
    x:Class="winuitest.Views.StartupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource LumaStartupBackgroundBrush}"
    IsTabStop="False"
    AutomationProperties.Name="Luma Music 正在启动"
    Loaded="View_Loaded" Unloaded="View_Unloaded">
    <Grid Background="{ThemeResource LumaStartupBackgroundBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0" Margin="24">
            <Grid Width="168" Height="168" HorizontalAlignment="Center">
                <Ellipse x:Name="LogoHalo" Width="148" Height="148" Fill="{ThemeResource LumaAccentBrush}"
                         Opacity="0.08" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <!-- Match Assets/Luma.svg using XAML geometry, so the very first
                     frame never waits for an image decoder or an icon font. -->
                <Grid x:Name="LogoMotion" Width="104" Height="104" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Viewbox>
                        <Canvas Width="256" Height="256">
                            <Rectangle Canvas.Left="4" Canvas.Top="4" Width="248" Height="248" RadiusX="56" RadiusY="56">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#F4617E" Offset="0" />
                                        <GradientStop Color="#E94764" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Path Fill="White" Data="M111 82 Q111 76 117 75 L184 59 Q190 58 190 65 L190 150 L178 150 L178 88 L123 101 L123 173 L111 173 Z" />
                            <Ellipse Canvas.Left="76" Canvas.Top="164" Width="50" Height="34" Fill="White" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><RotateTransform Angle="-20" /></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse Canvas.Left="143" Canvas.Top="141" Width="50" Height="34" Fill="White" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><RotateTransform Angle="-20" /></Ellipse.RenderTransform>
                            </Ellipse>
                        </Canvas>
                    </Viewbox>
                </Grid>
            </Grid>
            <TextBlock Text="Luma Music" FontFamily="Segoe UI Variable Display" FontSize="24" FontWeight="SemiBold"
                       CharacterSpacing="-20" Foreground="{ThemeResource LumaTextPrimaryBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,28" />
            <ProgressBar x:Name="LoadingProgress" Width="116" Height="3" MinHeight="3" Value="0" Maximum="100"
                         IsIndeterminate="False" Foreground="{ThemeResource LumaAccentBrush}"
                         HorizontalAlignment="Center" IsTabStop="False" AutomationProperties.Name="启动进度" />
        </StackPanel>
    </Grid>
</UserControl>
