                                    <ResourceDictionary x:Key="Light">
                                        <SolidColorBrush x:Key="ButtonBackground" Color="#242429" /><SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#3D3D45" /><SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#56565F" />
                                        <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF" /><SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" /><SolidColorBrush x:Key="ButtonForegroundPressed" Color="#EAEAF0" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="Dark">
                                        <SolidColorBrush x:Key="ButtonBackground" Color="#F5F5F7" /><SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFFFFF" /><SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#D7D7DE" />
                                        <SolidColorBrush x:Key="ButtonForeground" Color="#151518" /><SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#151518" /><SolidColorBrush x:Key="ButtonForegroundPressed" Color="#303038" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="Default">
                                        <SolidColorBrush x:Key="ButtonBackground" Color="#F5F5F7" /><SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFFFFF" /><SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#D7D7DE" />
                                        <SolidColorBrush x:Key="ButtonForeground" Color="#151518" /><SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#151518" /><SolidColorBrush x:Key="ButtonForegroundPressed" Color="#303038" />
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries></ResourceDictionary>
                            </Button.Resources>
                            <controls:FilledIcon x:Name="PlayPauseIcon" Kind="Play" FontSize="20" />
                        </Button>
                        <Button Style="{StaticResource PlayerIconButton}" Click="Next_Click" ToolTipService.ToolTip="下一首" AutomationProperties.Name="下一首"><controls:FilledIcon Kind="Next" FontSize="21" /></Button>
                        <Button x:Name="RepeatButton" Style="{StaticResource PlayerIconButton}" Click="Repeat_Click" ToolTipService.ToolTip="循环模式" AutomationProperties.Name="循环模式"><controls:FilledIcon x:Name="RepeatIcon" Kind="Repeat" FontSize="16" Foreground="{ThemeResource LumaTextSecondaryBrush}" /></Button>
                    </StackPanel>
                    <Grid Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="PositionLabel" Text="0:00" FontSize="10" Foreground="{ThemeResource LumaTextSecondaryBrush}" VerticalAlignment="Center" TextAlignment="Right" />
                        <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="SeekSlider_ValueChanged" IsEnabled="False" IsThumbToolTipEnabled="False" VerticalAlignment="Center" MinHeight="24" AutomationProperties.Name="播放进度" />
                        <TextBlock x:Name="DurationLabel" Grid.Column="2" Text="0:00" FontSize="10" Foreground="{ThemeResource LumaTextSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
                <StackPanel x:Name="PlayerTools" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border x:Name="PlayerQualityBadge" Visibility="Collapsed" Background="{ThemeResource TrialBadgeBackgroundBrush}" CornerRadius="8" Padding="8,4" VerticalAlignment="Center"><TextBlock x:Name="PlayerQuality" Text="试听" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TrialBadgeForegroundBrush}" /></Border>
                    <Button x:Name="QueueToggleButton" Visibility="Collapsed" Style="{StaticResource PlayerIconButton}" VerticalAlignment="Center" Click="ToggleQueue_Click" ToolTipService.ToolTip="待播清单" AutomationProperties.Name="显示播放队列"><controls:FilledIcon Kind="Queue" FontSize="18" /></Button>
                    <Button Style="{StaticResource PlayerIconButton}" VerticalAlignment="Center" Click="Volume_Click" ToolTipService.ToolTip="静音 / 恢复音量" AutomationProperties.Name="静音"><controls:FilledIcon x:Name="VolumeIcon" Kind="Volume" FontSize="18" Foreground="{ThemeResource LumaTextSecondaryBrush}" /></Button>
                    <Slider x:Name="VolumeSlider" Width="88" MinWidth="0" Minimum="0" Maximum="100" Value="70" StepFrequency="1" SmallChange="1" LargeChange="5" ValueChanged="VolumeSlider_ValueChanged" VerticalAlignment="Center" MinHeight="24" AutomationProperties.Name="音量" />
                </StackPanel>
            </Grid>
        </Border>
        <views:NowPlayingView x:Name="NowPlaying" Grid.RowSpan="3" Grid.ColumnSpan="2" Visibility="Collapsed" />
        <Border x:Name="Toast" Grid.Row="1" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20" Background="{ThemeResource LumaToastBackgroundBrush}" CornerRadius="10" Padding="20,12" Visibility="Collapsed"><TextBlock x:Name="ToastText" Foreground="{ThemeResource LumaToastForegroundBrush}" FontSize="12" /></Border>
        </Grid>
        <Grid x:Name="StartupLayer" Background="Transparent">
            <views:StartupView x:Name="StartupScreen" />
            <Grid x:Name="StartupDragRegion" Height="48" VerticalAlignment="Top" Background="Transparent" />
        </Grid>
    </Grid>
</Window>
