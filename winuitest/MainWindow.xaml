                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#DADAE0" /><SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FFFFFF" /><SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#E7E7EC" />
                            <SolidColorBrush x:Key="SliderThumbBackground" Color="#DADAE0" /><SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFF" /><SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#E7E7EC" />
