<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="winuitest.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:winuitest.Controls"
    xmlns:models="using:winuitest.Models" xmlns:views="using:winuitest.Views" Title="Luma Music">
    <Window.SystemBackdrop><MicaBackdrop Kind="BaseAlt" /></Window.SystemBackdrop>
    <Grid x:Name="Root" RequestedTheme="Default" Background="{ThemeResource LumaWindowBrush}" KeyboardAcceleratorPlacementMode="Hidden" Loaded="Root_Loaded" SizeChanged="Root_SizeChanged">
        <Grid.Resources>
            <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="TrialBadgeBackgroundBrush" Color="#F9C3D3" /><SolidColorBrush x:Key="TrialBadgeForegroundBrush" Color="#AB123A" /></ResourceDictionary>
                <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="TrialBadgeBackgroundBrush" Color="#592037" /><SolidColorBrush x:Key="TrialBadgeForegroundBrush" Color="#FF7C98" /></ResourceDictionary>
                <ResourceDictionary x:Key="Default"><SolidColorBrush x:Key="TrialBadgeBackgroundBrush" Color="#592037" /><SolidColorBrush x:Key="TrialBadgeForegroundBrush" Color="#FF7C98" /></ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast"><SolidColorBrush x:Key="TrialBadgeBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" /><SolidColorBrush x:Key="TrialBadgeForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" /></ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <controls:ArtworkSourceConverter x:Key="ArtworkSourceConverter" />
            <!-- Native GridViewItemPresenter reads this resource for every pointer state. -->
            <CornerRadius x:Key="GridViewItemCornerRadius">16</CornerRadius>
            <Style x:Key="TrackListItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="PlaylistCardStyle" TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="Padding" Value="10,10,10,14" />
                <Setter Property="Margin" Value="4,4,4,8" />
                <Setter Property="CornerRadius" Value="16" />
            </Style>
            <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="8" />
                <Setter Property="Width" Value="36" /><Setter Property="Height" Value="36" /><Setter Property="Padding" Value="0" />
            </Style>
            <Style x:Key="PlayerIconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource LumaTextSecondaryBrush}" />
                <Setter Property="CornerRadius" Value="16" /><Setter Property="Width" Value="32" /><Setter Property="Height" Value="32" /><Setter Property="Padding" Value="0" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{ThemeResource LumaTextPrimaryBrush}" /><Setter Property="CharacterSpacing" Value="-25" />
            </Style>
            <Style x:Key="TrackTextLinkStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Foreground" Value="{ThemeResource LumaTextSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" /><Setter Property="MinHeight" Value="0" /><Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="0" /><Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <ContentPresenter x:Name="LinkContent" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="Center" Background="Transparent">
                        <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver"><Storyboard><ObjectAnimationUsingKeyFrames Storyboard.TargetName="LinkContent" Storyboard.TargetProperty="Foreground"><DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource LumaTextPrimaryBrush}" /></ObjectAnimationUsingKeyFrames></Storyboard></VisualState>
                            <VisualState x:Name="Pressed"><Storyboard><ObjectAnimationUsingKeyFrames Storyboard.TargetName="LinkContent" Storyboard.TargetProperty="Foreground"><DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource LumaAccentTextBrush}" /></ObjectAnimationUsingKeyFrames></Storyboard></VisualState>
                            <VisualState x:Name="Disabled"><Storyboard><DoubleAnimation Storyboard.TargetName="LinkContent" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0" /></Storyboard></VisualState>
                        </VisualStateGroup></VisualStateManager.VisualStateGroups>
                    </ContentPresenter>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <DataTemplate x:Key="TrackTemplate" x:DataType="models:Track">
                <controls:TrackColumnsGrid Height="62" Background="Transparent" Tag="{x:Bind}" SizeChanged="TrackRow_SizeChanged" DoubleTapped="TrackRow_DoubleTapped" ContextRequested="TrackRow_ContextRequested">
                    <Border controls:TrackColumnsGrid.Field="Cover" Width="40" Height="40" VerticalAlignment="Center" Background="{ThemeResource LumaCardPlaceholderBrush}" CornerRadius="8"><Grid><controls:FilledIcon Kind="Music" FontSize="18" Foreground="{ThemeResource LumaTextTertiaryBrush}" Visibility="{x:Bind controls:TrackVisualState.Visible(IsMetadataLoaded)}" /><Image Source="{Binding ArtworkUrl, Mode=OneTime, Converter={StaticResource ArtworkSourceConverter}}" Stretch="Fill" /></Grid></Border>
                    <StackPanel controls:TrackColumnsGrid.Field="Title" VerticalAlignment="Center" Spacing="4" Visibility="{x:Bind controls:TrackVisualState.Visible(IsMetadataLoaded)}">
                        <TextBlock Tag="TrackTitle" Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border x:Name="TrackAccessBadge" Visibility="{x:Bind controls:TrackVisualState.BadgeVisibility(AccessLabel)}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0" Background="{ThemeResource TrialBadgeBackgroundBrush}" ToolTipService.ToolTip="{x:Bind AccessDescription}" VerticalAlignment="Center"><TextBlock Text="{x:Bind AccessLabel}" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource TrialBadgeForegroundBrush}" /></Border>
                            <controls:HandButton x:Name="TrackArtistLink" Grid.Column="1" Tag="{x:Bind}" Style="{StaticResource TrackTextLinkStyle}" Click="TrackArtist_Click" ToolTipService.ToolTip="查看歌手作品"><TextBlock Text="{x:Bind Artist}" FontSize="12" TextTrimming="CharacterEllipsis" /></controls:HandButton>
                        </Grid>
                    </StackPanel>
                    <StackPanel controls:TrackColumnsGrid.Field="Title" Spacing="9" VerticalAlignment="Center" Visibility="{x:Bind controls:TrackVisualState.Visible(IsMetadataLoading)}" IsHitTestVisible="False"><Border Height="12" Width="160" MaxWidth="160" HorizontalAlignment="Left" Background="{ThemeResource LumaCardPlaceholderBrush}" CornerRadius="5" /><Border Height="10" Width="88" HorizontalAlignment="Left" Background="{ThemeResource LumaCardPlaceholderBrush}" CornerRadius="4" /></StackPanel>
                    <Grid controls:TrackColumnsGrid.Field="Album" VerticalAlignment="Center">
                        <controls:HandButton x:Name="TrackAlbumLink" Tag="{x:Bind}" Style="{StaticResource TrackTextLinkStyle}" Click="TrackAlbum_Click" ToolTipService.ToolTip="查看专辑" Visibility="{x:Bind controls:TrackVisualState.Visible(IsMetadataLoaded)}"><TextBlock Text="{x:Bind Album}" FontSize="12" TextTrimming="CharacterEllipsis" /></controls:HandButton>
                        <Border Height="11" Width="88" HorizontalAlignment="Left" CornerRadius="5" Background="{ThemeResource LumaCardPlaceholderBrush}" Visibility="{x:Bind controls:TrackVisualState.Visible(IsMetadataLoading)}" IsHitTestVisible="False" />
                    </Grid>
                    <TextBlock controls:TrackColumnsGrid.Field="Duration" Text="{x:Bind DisplayDuration}" FontSize="12" Foreground="{ThemeResource LumaTextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="{x:Bind controls:TrackVisualState.Visible(IsMetadataLoaded)}" />
                    <Button controls:TrackColumnsGrid.Field="Favorite" Tag="{x:Bind}" Click="FavoriteTrack_Click" Loaded="FavoriteButton_Loaded" Style="{StaticResource IconButton}" Width="32" Height="36" VerticalAlignment="Center" ToolTipService.ToolTip="收藏 / 取消收藏" AutomationProperties.Name="收藏歌曲" Visibility="{x:Bind controls:TrackVisualState.Visible(IsMetadataLoaded)}"><controls:FilledIcon Kind="HeartOff" FontSize="15" Foreground="{ThemeResource LumaTextSecondaryBrush}" /></Button>
                    <Button controls:TrackColumnsGrid.Field="More" Tag="{x:Bind}" Click="TrackActions_Click" Style="{StaticResource IconButton}" Width="32" Height="36" VerticalAlignment="Center" ToolTipService.ToolTip="更多" AutomationProperties.Name="歌曲选项" Visibility="{x:Bind controls:TrackVisualState.Visible(IsMetadataLoaded)}"><controls:FilledIcon Kind="More" FontSize="16" /></Button>
                </controls:TrackColumnsGrid>
            </DataTemplate>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid x:Name="Shell" Opacity="0" IsHitTestVisible="False">
        <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition x:Name="PlayerBarRow" Height="96" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Grid.RowSpan="2" Background="{ThemeResource LumaSidebarBrush}" BorderBrush="{ThemeResource LumaBorderBrush}" BorderThickness="0,0,1,0" />
        <Grid Grid.ColumnSpan="2" Height="48"><Grid Margin="20,0,0,0" ColumnSpacing="8" HorizontalAlignment="Left" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><controls:LumaBrandMark Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" /><TextBlock Grid.Column="1" FontSize="17" CharacterSpacing="-30" VerticalAlignment="Center"><Run Text="Luma " FontWeight="Bold" /><Run Text="Music" Foreground="{ThemeResource LumaTextSecondaryBrush}" /></TextBlock></Grid></Grid>
        <StackPanel x:Name="HistoryControls" Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="28,0,0,0">
            <Button x:Name="HistoryBackButton" Click="HistoryBack_Click" IsEnabled="False" Style="{StaticResource IconButton}" Width="32" Height="32" AutomationProperties.Name="返回" ToolTipService.ToolTip="返回 (Alt+←)"><controls:FilledIcon Kind="Back" FontSize="17" /></Button>
            <Button x:Name="HistoryForwardButton" Click="HistoryForward_Click" IsEnabled="False" Style="{StaticResource IconButton}" Width="32" Height="32" AutomationProperties.Name="前进" ToolTipService.ToolTip="前进 (Alt+→)"><controls:FilledIcon Kind="Forward" FontSize="17" /></Button>
        </StackPanel>
        <Grid x:Name="DragRegion" Grid.Column="1" Height="48" Margin="108,0,0,0" Background="Transparent" />
        <NavigationView x:Name="MainNavigation" Grid.Row="1" PaneDisplayMode="Left"
            IsPaneOpen="True" OpenPaneLength="220" CompactPaneLength="48"
            IsPaneToggleButtonVisible="False" IsBackButtonVisible="Collapsed"
            IsTitleBarAutoPaddingEnabled="False" IsSettingsVisible="True"
            Background="Transparent" ItemInvoked="MainNavigation_ItemInvoked">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                <Thickness x:Key="NavigationViewItemMargin">12,2,12,2</Thickness>
                <CornerRadius x:Key="NavigationViewItemCornerRadius">7</CornerRadius>
            </NavigationView.Resources>
            <NavigationView.PaneHeader>
                <Button x:Name="AccountButton" Click="Account_Click" Margin="12,12,12,18" Padding="8,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" CornerRadius="8" AutomationProperties.Name="网易云音乐账号">
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /></Grid.ColumnDefinitions>
                        <Grid Width="32" Height="32" VerticalAlignment="Center"><Border x:Name="SidebarGuestBadge" CornerRadius="16" Background="{ThemeResource LumaCardPlaceholderBrush}"><controls:FilledIcon Kind="Person" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><PersonPicture x:Name="SidebarAvatar" Width="32" Height="32" Visibility="Collapsed" /></Grid>
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center"><TextBlock x:Name="SidebarAccountName" Text="登录网易云音乐" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="SidebarAccountCaption" Text="同步你的音乐" FontSize="11" Foreground="{ThemeResource LumaTextSecondaryBrush}" TextTrimming="CharacterEllipsis" /></StackPanel>
                        <controls:FilledIcon Grid.Column="2" Kind="ChevronRight" FontSize="10" Foreground="{ThemeResource LumaTextTertiaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItemHeader Content="浏览" />
                <NavigationViewItem x:Name="DiscoverNav" Content="现在就听" Tag="discover"><NavigationViewItem.Icon><controls:FilledIcon Kind="Home" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItemHeader Content="本地" />
                <NavigationViewItem x:Name="FavoritesNav" Content="喜欢的歌曲" Tag="favorites"><NavigationViewItem.Icon><controls:FilledIcon Kind="HeartOff" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="RecentNav" Content="最近播放" Tag="recent"><NavigationViewItem.Icon><controls:FilledIcon Kind="Clock" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItemHeader Content="网易云音乐" />
                <NavigationViewItem x:Name="CloudNav" Content="我的歌单" Tag="cloud"><NavigationViewItem.Icon><controls:FilledIcon Kind="Playlist" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>
            <!-- Cloud playlist NavigationViewItems are inserted directly after CloudNav.
                 The native menu scrolls as one group; the built-in settings row stays below. -->
        </NavigationView>
        <Grid Grid.Row="1" Grid.Column="1" Background="{ThemeResource LumaSurfaceBrush}" CornerRadius="12,0,0,0" BorderBrush="{ThemeResource LumaBorderBrush}" BorderThickness="1,1,0,0">
            <Grid.RowDefinitions><RowDefinition Height="66" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid x:Name="PageToolbar" Margin="36,0,36,12" ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="SearchColumn" Width="320" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="Breadcrumb" Text="为你发现" FontSize="13" Foreground="{ThemeResource LumaTextSecondaryBrush}" VerticalAlignment="Center" />
                <AutoSuggestBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="搜索歌曲、歌手、专辑" QueryIcon="Find" QuerySubmitted="SearchBox_QuerySubmitted" CornerRadius="9" VerticalAlignment="Center" AutomationProperties.Name="搜索云端音乐" />
                <Button x:Name="RefreshButton" Grid.Column="2" Style="{StaticResource IconButton}" Click="Refresh_Click" ToolTipService.ToolTip="刷新" AutomationProperties.Name="刷新内容"><controls:FilledIcon Kind="Refresh" FontSize="16" Foreground="{ThemeResource LumaTextSecondaryBrush}" /></Button>
            </Grid>
            <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="True" Severity="Error" Margin="36,0,36,14" />
            <Grid Grid.Row="2">
                <Grid x:Name="PageBody">
                    <ScrollViewer x:Name="HomeView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch">
                        <StackPanel x:Name="HomeContent" Margin="36,0,36,32" Spacing="24">
                            <Grid><StackPanel Spacing="6"><TextBlock x:Name="TodayLabel" Text="" FontSize="12" Foreground="{ThemeResource LumaTextSecondaryBrush}" /><TextBlock x:Name="HomePageTitle" Text="现在就听" FontSize="32" FontWeight="Bold" CharacterSpacing="-50" /></StackPanel></Grid>
                            <Button x:Name="HeroButton" Click="Hero_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" BorderThickness="0" CornerRadius="16" Height="220" AutomationProperties.Name="播放新歌">
                                <Button.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0.8"><GradientStop Color="{ThemeResource LumaHeroStartColor}" Offset="0" /><GradientStop Color="{ThemeResource LumaHeroMidColor}" Offset="0.6" /><GradientStop Color="{ThemeResource LumaHeroEndColor}" Offset="1" /></LinearGradientBrush></Button.Background>
                                <Grid>
                                    <Ellipse Width="360" Height="360" HorizontalAlignment="Right" Margin="0,-120,-50,0" Fill="#24FFFFFF" />
                                    <Ellipse Width="280" Height="280" HorizontalAlignment="Right" Margin="0,120,140,-190" Fill="#19FFFFFF" />
                                    <StackPanel Margin="32,27,0,0" Spacing="12" HorizontalAlignment="Left">
                                        <TextBlock Text="新歌推荐" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource LumaTextSecondaryBrush}" CharacterSpacing="180" />
                                        <TextBlock Text="发现新声音" FontSize="34" FontWeight="Bold" LineHeight="46" Foreground="{ThemeResource LumaTextPrimaryBrush}" CharacterSpacing="-60" />

                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,5,0,0"><Border Background="{ThemeResource LumaAccentBrush}" CornerRadius="16" Padding="15,8"><StackPanel Orientation="Horizontal" Spacing="7"><controls:FilledIcon Kind="Play" FontSize="10" Foreground="{ThemeResource LumaOnAccentBrush}" /><TextBlock Text="播放新歌" FontSize="11" Foreground="{ThemeResource LumaOnAccentBrush}" FontWeight="SemiBold" /></StackPanel></Border></StackPanel>
                                    </StackPanel>
                                    <Border x:Name="HeroArtworkBorder" Width="172" Height="172" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,45,0" CornerRadius="9" Background="{ThemeResource LumaCardPlaceholderBrush}" Rotation="8"><Grid><controls:FilledIcon Kind="Music" FontSize="80" Foreground="{ThemeResource LumaTextTertiaryBrush}" /><Image x:Name="HeroArtwork" Stretch="Fill" /></Grid></Border>
                                </Grid>
                            </Button>
                            <Grid><TextBlock Text="为你精选" Style="{StaticResource SectionTitle}" /></Grid>
                            <GridView x:Name="PlaylistGrid" IsItemClickEnabled="True" ItemClick="PlaylistGrid_ItemClick" SelectionMode="None" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" Margin="-14,-4,-14,0" ItemContainerStyle="{StaticResource PlaylistCardStyle}" Loaded="PlaylistCards_Loaded" SizeChanged="PlaylistCards_SizeChanged">
                                <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="172" /></ItemsPanelTemplate></GridView.ItemsPanel>
                                <GridView.ItemTemplate><DataTemplate x:DataType="models:MusicPlaylist"><StackPanel Spacing="12">
                                    <Border SizeChanged="SquareArtwork_SizeChanged" Height="156" CornerRadius="14" Background="{ThemeResource LumaCardPlaceholderBrush}"><Grid><controls:FilledIcon Kind="Music" FontSize="40" Foreground="{ThemeResource LumaTextTertiaryBrush}" /><Image Source="{Binding ArtworkUrl, Mode=OneTime, Converter={StaticResource ArtworkSourceConverter}}" Stretch="Fill" /><Border Background="#65000000" CornerRadius="7" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" Padding="7,4"><StackPanel Orientation="Horizontal" Spacing="4"><controls:FilledIcon Kind="Play" FontSize="8" Foreground="White" /><TextBlock Text="{x:Bind PlayCountLabel}" FontSize="9" Foreground="White" /></StackPanel></Border></Grid></Border>
                                    <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />

                                </StackPanel></DataTemplate></GridView.ItemTemplate>
                            </GridView>
                            <Grid><TextBlock Text="新歌速递" Style="{StaticResource SectionTitle}" /><Button Content="查看全部  ›" Click="AllNewSongs_Click" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource LumaAccentBrush}" FontSize="12" /></Grid>
                            <ListView x:Name="HomeSongs" SelectionMode="Extended" IsMultiSelectCheckBoxEnabled="False" IsItemClickEnabled="False" KeyDown="TrackList_KeyDown" ContextRequested="TrackList_ContextRequested" ItemTemplate="{StaticResource TrackTemplate}" ItemContainerStyle="{StaticResource TrackListItemStyle}" Padding="0" ScrollViewer.VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" />

                        </StackPanel>
                    </ScrollViewer>
                    <Grid x:Name="TracksView" Visibility="Collapsed" Margin="36,0,36,20">
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <ListView x:Name="TrackList" SelectionChanged="TrackList_SelectionChanged" SelectionMode="Extended" IsMultiSelectCheckBoxEnabled="False" IsItemClickEnabled="False" KeyDown="TrackList_KeyDown" ContextRequested="TrackList_ContextRequested" ItemTemplate="{StaticResource TrackTemplate}" ItemContainerStyle="{StaticResource TrackListItemStyle}" Padding="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Loaded="TrackList_Loaded" Unloaded="TrackList_Unloaded" SizeChanged="TrackList_SizeChanged" AutomationProperties.Name="歌曲列表">
                            <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel BringIntoViewRequested="TrackItemsPanel_BringIntoViewRequested" /></ItemsPanelTemplate></ListView.ItemsPanel>
                            <ListView.Header>
                                <StackPanel x:Name="CollectionScrollHeader" HorizontalAlignment="Stretch">
                                    <Grid x:Name="CollectionHeader" Margin="12,4,12,24" SizeChanged="CollectionHeader_SizeChanged">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border x:Name="CollectionCoverBorder" Width="120" Height="120" Margin="0,0,24,0" CornerRadius="12" Background="{ThemeResource LumaCardPlaceholderBrush}" Visibility="Collapsed"><Image x:Name="CollectionCover" Stretch="Fill" /></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="9"><controls:HandButton x:Name="AlbumArtistBackButton" Visibility="Collapsed" Content="返回歌手" Click="ArtistBack_Click" Background="Transparent" BorderThickness="0" Padding="0,3" MinHeight="0" FontSize="12" Foreground="{ThemeResource LumaAccentTextBrush}" /><TextBlock x:Name="CollectionEyebrow" Visibility="Collapsed" Text="YOUR MUSIC" FontSize="10" Foreground="{ThemeResource LumaAccentBrush}" CharacterSpacing="160" /><TextBlock x:Name="PageTitle" FontSize="32" FontWeight="Bold" CharacterSpacing="-50" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="PageDescription" Foreground="{ThemeResource LumaTextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" /><Button x:Name="PlayAllButton" Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="播放全部歌曲" Click="PlayAll_Click" Background="{ThemeResource LumaAccentBrush}" Foreground="{ThemeResource LumaOnAccentBrush}" BorderThickness="0" CornerRadius="18" Margin="0,4,0,0" Padding="16,9"><StackPanel Orientation="Horizontal" Spacing="8"><controls:FilledIcon Kind="Play" FontSize="12" /><TextBlock Text="播放全部" FontSize="12" /></StackPanel></Button></StackPanel>
                                    </Grid>
                                    <controls:TrackColumnsGrid x:Name="TrackHeader" Height="40" BorderBrush="{ThemeResource LumaBorderBrush}" BorderThickness="0,0,0,1" HorizontalAlignment="Left">
                                        <TextBlock controls:TrackColumnsGrid.Field="Title" Text="歌曲 / 歌手" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource LumaTextTertiaryBrush}" />
                                        <TextBlock controls:TrackColumnsGrid.Field="Album" Text="专辑" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource LumaTextTertiaryBrush}" />
                                        <TextBlock controls:TrackColumnsGrid.Field="Duration" Text="时长" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource LumaTextTertiaryBrush}" HorizontalAlignment="Right" />
                                    </controls:TrackColumnsGrid>
                                </StackPanel>
                            </ListView.Header>
                        </ListView>
                        <StackPanel x:Name="CompactCollectionHeader" PointerWheelChanged="CompactCollectionHeader_PointerWheelChanged" VerticalAlignment="Top" Background="Transparent" Visibility="Collapsed">
                            <Grid Height="56" Padding="12,6" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Button Style="{StaticResource AccentButtonStyle}" Width="36" Height="36" Padding="0" CornerRadius="18" Click="PlayAll_Click" IsEnabled="{Binding IsEnabled, ElementName=PlayAllButton}" AutomationProperties.Name="播放全部歌曲"><controls:FilledIcon Kind="Play" FontSize="16" /></Button>
                                <TextBlock Grid.Column="1" Text="{Binding Text, ElementName=PageTitle}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock x:Name="TrackSelectionLabel" Grid.Column="2" FontSize="12" Foreground="{ThemeResource LumaTextSecondaryBrush}" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                            <controls:TrackColumnsGrid x:Name="StickyTrackHeader" Height="40" BorderBrush="{ThemeResource LumaBorderBrush}" BorderThickness="0,0,0,1" HorizontalAlignment="Left">
                                <TextBlock controls:TrackColumnsGrid.Field="Title" Text="歌曲 / 歌手" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource LumaTextTertiaryBrush}" />
                                <TextBlock controls:TrackColumnsGrid.Field="Album" Text="专辑" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource LumaTextTertiaryBrush}" />
                                <TextBlock controls:TrackColumnsGrid.Field="Duration" Text="时长" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource LumaTextTertiaryBrush}" HorizontalAlignment="Right" />
                            </controls:TrackColumnsGrid>
                        </StackPanel>
                        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,144,0,0" Spacing="12" MaxWidth="360"><controls:FilledIcon x:Name="EmptyIcon" Kind="Search" Foreground="{ThemeResource LumaTextTertiaryBrush}" FontSize="40" /><TextBlock x:Name="EmptyTitle" Text="搜索音乐" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock x:Name="EmptyDescription" Text="输入歌曲或歌手" FontSize="12" Foreground="{ThemeResource LumaTextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" /></StackPanel>
