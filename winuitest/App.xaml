                    <SolidColorBrush x:Key="LumaPlayerBrush" Color="#E0222227" />
                    <SolidColorBrush x:Key="LumaInspectorBrush" Color="#E029292F" />
                    <SolidColorBrush x:Key="LumaTextPrimaryBrush" Color="#F5F5F7" />
                    <SolidColorBrush x:Key="LumaTextSecondaryBrush" Color="#C3C3CB" />
                    <SolidColorBrush x:Key="LumaTextTertiaryBrush" Color="#9999A5" />
                    <SolidColorBrush x:Key="LumaAccentBrush" Color="#F57891" />
                    <SolidColorBrush x:Key="LumaAccentTextBrush" Color="#FF9DB1" />
                    <SolidColorBrush x:Key="LumaOnAccentBrush" Color="#2D0C17" />
                    <SolidColorBrush x:Key="LumaCardPlaceholderBrush" Color="#783D3D46" />
                    <SolidColorBrush x:Key="LumaBorderBrush" Color="#20FFFFFF" />
                    <SolidColorBrush x:Key="LumaSkeletonBrush" Color="#18FFFFFF" />
                    <SolidColorBrush x:Key="LumaToastBackgroundBrush" Color="#F4E8DEE9" />
                    <SolidColorBrush x:Key="LumaToastForegroundBrush" Color="#302333" />
                    <SolidColorBrush x:Key="LumaLyricMutedBrush" Color="#A899B4" />
                    <SolidColorBrush x:Key="LumaLyricActiveBrush" Color="#FBF5FF" />
                    <SolidColorBrush x:Key="LumaLyricCompletedBrush" Color="#F4A5BA" />
                    <SolidColorBrush x:Key="LumaLyricCurrentBrush" Color="#FF799E" />
                    <LinearGradientBrush x:Key="LumaLyricsBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource LumaLyricsStartColor}" Offset="0" />
                        <GradientStop Color="{StaticResource LumaLyricsMidColor}" Offset="0.58" />
                        <GradientStop Color="{StaticResource LumaLyricsEndColor}" Offset="1" />
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="LumaStartupBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <StaticResource x:Key="LumaHeroStartColor" ResourceKey="SystemColorWindowColor" />
                    <StaticResource x:Key="LumaHeroMidColor" ResourceKey="SystemColorWindowColor" />
                    <StaticResource x:Key="LumaHeroEndColor" ResourceKey="SystemColorWindowColor" />
                    <StaticResource x:Key="LumaLyricsStartColor" ResourceKey="SystemColorWindowColor" />
                    <StaticResource x:Key="LumaLyricsMidColor" ResourceKey="SystemColorWindowColor" />
                    <StaticResource x:Key="LumaLyricsEndColor" ResourceKey="SystemColorWindowColor" />
                    <SolidColorBrush x:Key="LumaWindowBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="LumaSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="LumaSidebarBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="LumaPlayerBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="LumaInspectorBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="LumaTextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="LumaTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="LumaTextTertiaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="LumaAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="LumaAccentTextBrush" Color="{ThemeResource SystemColorHotlightColor}" />
                    <SolidColorBrush x:Key="LumaOnAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="LumaCardPlaceholderBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="LumaBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="LumaSkeletonBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="LumaToastBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="LumaToastForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="LumaLyricMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="LumaLyricActiveBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="LumaLyricCompletedBrush" Color="{ThemeResource SystemColorHotlightColor}" />
                    <SolidColorBrush x:Key="LumaLyricCurrentBrush" Color="{ThemeResource SystemColorHotlightColor}" />
                    <SolidColorBrush x:Key="LumaLyricsBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
